# ==============================================================================
# redFlag Environment Configuration
# ==============================================================================
# In production (Render or Vercel), configure these in your platform Dashboard.

# Application Security
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-string-for-production
ALLOWED_HOSTS=.onrender.com,.vercel.app,localhost,127.0.0.1

# Database Configuration
# In Render: Automatically injected via PostgreSQL connection string
# In Neon / Supabase: postgres://user:password@host:5432/dbname
# Local SQLite default: (leave empty or unset to use local db.sqlite3)
DATABASE_URL=postgres://user:password@host:5432/dbname

# CSRF & HTTPS Security
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app,http://localhost:8000
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Automatic Admin Superuser Creation on Free Tier Deployments
# (Set these in Render Web Service environment variables to create your admin account for free)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@redflag.org
DJANGO_SUPERUSER_PASSWORD=ChangeMeInProduction123!
